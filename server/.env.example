# ===================================================
# ENHANCEUS BACKEND ENVIRONMENT CONFIGURATION
# ===================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/enhanceus
# MongoDB Atlas Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/enhanceus
MONGODB_URI=mongodb://127.0.0.1:27017/enhanceus

# JWT & Cookie Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Dedicated Isolated Demo Account Configuration
DEMO_USER_EMAIL=demo@enhanceus.org
DEMO_USER_PASSWORD=DemoPassword123!

# ===================================================
# GOOGLE GEMINI AI CONFIGURATION
# ===================================================
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# Required for AI-powered goal decomposition & competency roadmaps.
# If omitted or left blank, EnhanceUs automatically falls back to its local rule-based skill engine.
GEMINI_API_KEY=

# Gemini model identifier (Optional, defaults to gemini-1.5-flash)
# Supported options: gemini-1.5-flash, gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# In-Memory DB Mode (Only for offline testing without MongoDB; live accounts always use MongoDB)
MOCK_DB=false

# ===================================================
# PLUNK TRANSACTIONAL EMAIL CONFIGURATION
# ===================================================
# Plunk Secret API Key obtained from your Plunk Project Settings (https://useplunk.com)
# Used for cryptographic email verification, password reset links, and feedback delivery
PLUNK_API_KEY=your_plunk_secret_api_key_here

# Authorized sender email address on your verified domain (briefenai.me)
# Configure in Plunk once DNS records (SPF, DKIM, DMARC) are verified
PLUNK_FROM_EMAIL=no-reply@briefenai.me

# Support and platform user feedback destination inbox
# Inbound messages sent to support@briefenai.me forward to your personal inbox via Namecheap
SUPPORT_EMAIL=support@briefenai.me
FEEDBACK_TO_EMAIL=support@briefenai.me

# Canonical Frontend Application URL
# Used for constructing secure, trusted verification and reset links (Host header spoofing defense)
CLIENT_URL=https://www.briefenai.me

# ===================================================
# LEGACY SMTP CONFIGURATION (Optional fallback)
# ===================================================
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
